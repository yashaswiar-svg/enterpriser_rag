# Enterprise Research Assistant RAG — Environment Variables
# Copy this file to .env and fill in your values

# ── LLM API Keys ──────────────────────────────────────────────────────────────
# Primary LLM (required for full functionality)
GOOGLE_API_KEY=your_google_api_key_here

# Fallback LLM (optional but recommended)
OPENAI_API_KEY=your_openai_api_key_here

# ── LangSmith Monitoring (optional) ──────────────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=enterprise-rag

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=Enterprise Research Assistant RAG
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production

# ── LLM Settings ─────────────────────────────────────────────────────────────
PRIMARY_LLM=gemini
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=8192
LLM_TIMEOUT=60

# ── Embedding Settings ────────────────────────────────────────────────────────
PRIMARY_EMBEDDING=gemini
GEMINI_EMBEDDING_MODEL=models/text-embedding-004
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=100
EMBEDDING_DIM=768

# ── Vector Store ─────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=enterprise_rag
FAISS_INDEX_PATH=./chroma_db/faiss_index

# ── Document Processing ───────────────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_FILE_SIZE_MB=100
BATCH_SIZE=50

# ── Retrieval ─────────────────────────────────────────────────────────────────
VECTOR_SEARCH_TOP_K=20
RERANK_TOP_N=5
HYBRID_SEARCH_ALPHA=0.5

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (default, no setup needed)
DATABASE_URL=sqlite:///./enterprise_rag.db

# PostgreSQL (for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/enterprise_rag

# ── Paths ─────────────────────────────────────────────────────────────────────
DATA_DIR=./data
DOCUMENTS_DIR=./data/documents
METADATA_DIR=./data/metadata
REPORTS_DIR=./reports
LOGS_DIR=./logs

# ── Security ─────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-secure-random-key-in-production
ALLOWED_ORIGINS=["*"]

# ── Performance ───────────────────────────────────────────────────────────────
MAX_CONTEXT_TOKENS=100000
CACHE_TTL=3600
MAX_CONCURRENT_REQUESTS=10
WORKER_THREADS=4
